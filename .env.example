# Copy this file to .env and replace the placeholder values with your local secrets.
# This repository ignores .env, so real secrets stay out of source control.

API_BASE_URL=http://localhost:8080/api/v1

DB_URL=jdbc:mysql://localhost:3306/taxratesystem?useSSL=false&serverTimezone=Asia/Manila&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

JWT_SECRET=change_me_to_a_32_char_or_longer_random_value
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address
MAIL_PASSWORD=your_gmail_app_password

FRONTEND_URL=http://localhost:3000
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=5
PASSWORD_RESET_EXPIRATION_MINUTES=15
MAIL_ENABLED=true
